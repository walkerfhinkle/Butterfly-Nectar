# These are set in Netlify (Site configuration > Environment variables), NOT in the repo.
# This file just documents them. For local testing, copy to .env (it is git-ignored).

# Stripe > Developers > API keys. sk_test_... while testing, sk_live_... after the LLC account is active.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Stripe > Developers > Webhooks > your endpoint > Signing secret. Starts with whsec_...
# Test mode and live mode each have their OWN webhook + secret.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# resend.com > API Keys (create one with "Sending access").
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Optional. Defaults shown.
EMAIL_TO=shopbutterflynectar@gmail.com
EMAIL_FROM=Butterfly Nectar Orders <onboarding@resend.dev>

# Optional. Defaults to whatever address the site is being served from.
# SITE_URL=https://butterflynectar.shop
